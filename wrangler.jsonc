{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-chatbot",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chatbot",
			"database_id": "44460e0d-c514-4ec8-8e2e-7e65cf655c8a",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "1dc5705ffe11455c942b06d92e1f679f"
		}
	],
	"observability": {
		"enabled": true
	}
}